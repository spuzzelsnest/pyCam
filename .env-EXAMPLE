# Copy to .env (next to hikvisionSite.py) and adjust. Keep .env out of git.
# Plain KEY=value lines: no "export", no spaces around "=".
PYCAM_PORT=8000
PYCAM_DURATION=10
PYCAM_NAME=Cam1
PYCAM_WATERMARK="THIS IS A SECRET RECORDING"

# Raw clips (private to the service, wiped on restart) and finished .mp4 files.
# The service user must be able to write to PYCAM_OUT_DIR:
#   sudo mkdir -p /FTP/recordings && sudo chown pycam:pycam /FTP/recordings
PYCAM_TMP_DIR=/tmp/FTP/recordings
PYCAM_OUT_DIR=/FTP/recordings

# DEBUG, INFO, WARNING, ERROR
PYCAM_LOG_LEVEL=INFO
